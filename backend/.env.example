# Copy this file to .env and fill in the values.
# Never commit the real .env - it is git-ignored.

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URL=

# Auth
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# AWS S3 (resume and profile image storage)
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Razorpay (premium payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OpenAI (ATS resume scoring)
OPENAI_API_KEY=
